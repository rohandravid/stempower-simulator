# Used by server/index.mjs (the AI Helper proxy — run with `npm run server`).
# Copy this file to server/.env (preferred), or to a root .env, or just
# export ANTHROPIC_API_KEY in your shell before starting the server.
# Without a key (or an `ant auth login` profile), the server still starts and
# /api/health still works — /api/assistant just replies with a friendly
# "AI Helper isn't set up" message instead of a live answer.
ANTHROPIC_API_KEY=sk-ant-...
